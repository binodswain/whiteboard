# Copy to .env, then set PUID and PGID to your host user IDs (see docs/docker.md).
PUID=1000
PGID=1000
# Optional checkout path to mount at /workspace (defaults to this repository).
REPOSITORY=.
# Optional: claude, codex, or none (default).
AGENT=none
# Set a shared access token to protect the web UI and API.
WHITEBOARD_TOKEN=
# Optional GitHub authentication for private PRs/GitHub Enterprise.
GH_TOKEN=
GH_ENTERPRISE_TOKEN=
GH_HOST=
# Optional keys for host-connected agents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
