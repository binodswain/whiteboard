# Compose applies these IDs to the container process. Set them for your host user:
# printf 'UID=%s\nGID=%s\n' "$(id -u)" "$(id -g)" >> .env
UID=1000
GID=1000
# Absolute host directory to mount at the same path inside the container.
CODE_ROOT=/absolute/path/to/checkout
# Published host port (defaults to 7421).
WHITEBOARD_PORT=7421
# Optional data directory (defaults to ~/.whiteboard/docker).
WHITEBOARD_DATA_DIR=
# Optional: claude, codex, or none (default).
AGENT=none
# Set a shared access token to protect the web UI and API.
WHITEBOARD_TOKEN=
# Local tokenless access for loopback browser and MCP clients.
WHITEBOARD_LOCAL_BROWSER_AUTH=1
# Optional GitHub authentication for private PRs/GitHub Enterprise.
GH_TOKEN=
GH_ENTERPRISE_TOKEN=
GH_HOST=
# Optional keys for host-connected agents.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Shared bearer secret for queue-provider calls to POST /internal/jobs/run.
# Leave unset when WHITEBOARD_JOBS=inline.
WHITEBOARD_JOB_SECRET=

# Remote-dev profile defaults are provided by docker-compose.yml. Uncomment
# values to override them. For local Docker, keep these unset.
# WHITEBOARD_DB=postgres://whiteboard:whiteboard@postgres:5432/whiteboard
# WHITEBOARD_BLOBS=s3://whiteboard
# WHITEBOARD_S3_ENDPOINT=http://minio:9000
# WHITEBOARD_S3_REGION=us-east-1
# WHITEBOARD_S3_KEY=whiteboard
# WHITEBOARD_S3_SECRET=whiteboard-secret
# WHITEBOARD_REPO_SOURCE=github
# WHITEBOARD_JOBS=queue
# WHITEBOARD_AUTH=oauth
# WHITEBOARD_AUTH_SECRET=remote-dev-session-secret
# WHITEBOARD_AUTH_PROXY_HEADER=x-whiteboard-user
# WHITEBOARD_AUTH_PROXY_SECRET=remote-dev-proxy-secret
# WHITEBOARD_AUTH_PROXY_SECRET_HEADER=x-whiteboard-proxy-secret
